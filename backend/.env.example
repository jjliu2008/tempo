# Copy to backend/.env and adjust. Never commit the real .env.
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=API
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google AI Studio key; GEMINI_API_KEY is also accepted. Leave empty to disable Gemma.
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TEMPERATURE=0.7
GEMMA_MAX_OUTPUT_TOKENS=2048
GEMMA_TIMEOUT_SECONDS=60
GEMMA_MAX_CONCURRENT_REQUESTS=4
# The hellweek CLI (python -m hellweek ... --gemma) reads the same key. It tries
# gemma-4-26b-a4b-it then gemma-4-31b-it; set this to force one model:
# HELLWEEK_GEMMA_MODEL=gemma-4-31b-it

# Calendar connections: generate a key with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_ENCRYPTION_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/api/v1/calendars/google/callback
CALENDAR_FRONTEND_URL=http://localhost:5173
# DATABASE_URL above is used for sessions and encrypted connections.
# Local alternative: DATABASE_URL=sqlite+aiosqlite:///./calendars.db
