# Copy to backend/.env and adjust. Never commit the real .env.
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=API
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google AI Studio key; GEMINI_API_KEY is also accepted. Leave empty to disable Gemma.
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TEMPERATURE=0.7
GEMMA_MAX_OUTPUT_TOKENS=2048
GEMMA_TIMEOUT_SECONDS=60
GEMMA_MAX_CONCURRENT_REQUESTS=4
